#!/bin/bash
# secret-drop: write-only drop box for the owner's secrets on episteck-node1.
#
# Reached only through one locked SSH key in ~episteck/.ssh/authorized_keys:
#   restrict,pty,command="sudo -n /usr/local/sbin/secret-drop" ssh-ed25519 AAAA... secret-drop-phone
# The key gets no shell, no other command and no forwarding. This script ignores whatever
# command the client asks for. It never prints, logs or reads back a secret.
#
# Each slot has a fixed target, owner and format. A slot that is already filled is never
# overwritten: Claude clears it first (with a backup) when a secret is rotated.
# Install: root:root 0755 at /usr/local/sbin/secret-drop.
set -euo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# name | kind (env = KEY=value line in an existing file, file = new file) | target | owner | env key | format | label
SLOTS=(
  "telegram|env|/home/home-agent/.hermes/.env|home-agent|TELEGRAM_BOT_TOKEN|^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$|Telegram bot token for Olin (Hermes home-agent)"
)

say() { printf '%s\n' "$*"; }
stamp() { date -u +%Y%m%dT%H%M%SZ; }

say "Secret drop (write-only). What are you storing?"
for i in "${!SLOTS[@]}"; do
  IFS='|' read -r name _ _ _ _ _ label <<<"${SLOTS[$i]}"
  say "  $((i + 1))) $name: $label"
done
read -r -t 120 -p "Number: " pick || { say "No answer. Nothing stored."; exit 1; }
[[ "$pick" =~ ^[0-9]+$ ]] && (( pick >= 1 && pick <= ${#SLOTS[@]} )) || { say "No such slot. Nothing stored."; exit 1; }
IFS='|' read -r name kind target owner key format label <<<"${SLOTS[$((pick - 1))]}"

if [ "$kind" = env ]; then
  [ -f "$target" ] || { say "Target file is missing. Nothing stored."; exit 1; }
  if grep -q "^${key}=" "$target"; then say "$name is already set. Nothing stored (ask Claude to clear it first)."; exit 1; fi
else
  [ ! -e "$target" ] || { say "$name is already set. Nothing stored (ask Claude to clear it first)."; exit 1; }
fi

read -r -s -t 300 -p "Paste it (hidden): " secret || { say; say "No answer. Nothing stored."; exit 1; }
say
if ! [[ "$secret" =~ $format ]]; then unset secret; say "That does not look like a $name secret. Nothing stored."; exit 1; fi

if [ "$kind" = env ]; then
  cp -p "$target" "$target.bak-secret-drop-$(stamp)"
  [ -z "$(tail -c1 "$target")" ] || printf '\n' >> "$target"
  printf '%s=%s\n' "$key" "$secret" >> "$target"
else
  install -m 600 -o "$owner" -g "$owner" /dev/null "$target"
  printf '%s' "$secret" >> "$target"
fi
unset secret
chown "$owner:$owner" "$target"
chmod 600 "$target"
logger -t secret-drop "stored slot=$name by ${SUDO_USER:-unknown}"
say "Stored $name. You can close this window. Tell Claude it is done."
